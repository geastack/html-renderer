{
  "name": "gea-html-renderer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "vars": { "RENDER_INSTANCE_TYPE": "lite" },
  "containers": [
    {
      "class_name": "RendererContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
          "build_context": "../..",
        },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RENDER",
        "class_name": "RendererContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RendererContainer"],
    },
  ],
}
