{
  "name": "@geastack/html-renderer",
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "postinstall": "node lib/install.mjs",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier . --write",
    "format:check": "eslint . && prettier . --check",
    "smoke:package": "node scripts/smoke-package.mjs",
    "visual:diff": "node scripts/visual-diff.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@geajs/core": "^1.5.1",
    "@geajs/vite-plugin": "^1.5.0",
    "@geastack/apple": "^0.2.26",
    "@geastack/cli": "^0.1.117",
    "@geastack/compiler": "^1.0.49",
    "@geastack/core": "^0.1.54",
    "@geastack/geatsc-plugin-gea": "^0.1.28",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0"
  },
  "gea": {
    "id": "html-renderer",
    "name": "Gea HTML Renderer",
    "entry": "src/index.ts",
    "runtime": "gea",
    "targets": {
      "macos": true,
      "windows": {
        "nativeIncludeDirectories": [
          "src/native"
        ]
      },
      "raspberry-pi-os": {
        "nativeIncludeDirectories": [
          "src/native"
        ]
      }
    },
    "nativeSources": [
      "src/native/html_host.cpp"
    ],
    "compilerPlugins": [
      "src/geatsc-plugin.mjs"
    ]
  },
  "description": "Render local HTML and CSS with the native GeaStack renderer",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geastack/html-renderer.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./lib/worker.d.ts",
      "import": "./lib/worker.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "NOTICE",
    "README.md",
    "bin",
    "lib",
    "dist/renderer-assets.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "gea-html-render": "bin/cli.mjs"
  }
}
